+                Ok(state) => state,
+                Err(err) => {
+                    eprintln!(
+                        "Warning: Could not fetch {} from Xet ({err}); leaving the pointer file",
+                        disk_path.display()
+                    );
+                    continue;
+                }
+            };
+            changed_file_states.push((path, state));
+        }
+        let paths = changed_file_states
+            .iter()
+            .map(|(path, _)| path.clone())
+            .collect();
+        self.file_states
+            .merge_in(changed_file_states, &HashSet::new());
+        Ok(paths)
+    }
