+                path.to_fs_path(&self.working_copy_path)
+                    .map_err(|err| CheckoutError::Other {
+                        message: format!("Invalid path {}", path.as_internal_file_string()),
+                        err: err.into(),
+                    })?;
+            let Some(pointer) = fs::read(&disk_path)
+                .ok()
+                .and_then(|contents| Pointer::parse(&contents))
+                .filter(|pointer| self.xet.should_clean(&path, pointer.size))
